{
  "manifest_version": 3,
  "name": "ShieldFocus",
  "version": "0.1.0",
  "description": "A local-first Chrome blocker with strict, privacy-preserving defaults.",
  "action": {
    "default_title": "ShieldFocus",
    "default_popup": "popup/popup.html"
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "options_page": "pages/options.html",
  "permissions": [
    "storage",
    "declarativeNetRequest",
    "alarms"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content/metadata-extractor.js",
        "content/page-scanner.js"
      ],
      "run_at": "document_end"
    }
  ]
}
